# 复制为 .env 并填入你的配置（.env 不会被提交）

# 联网搜索网关（qianfan web search）：阶段1 联网研究统一走这个网关，
# 而不是各 agent 环境自带的 WebSearch。填入网关密钥后 web_search.py 才能用。
QIANFAN_WEBSEARCH_API_KEY=your-key-here
# 网关地址（可选，不填用脚本内默认的预发地址）
# QIANFAN_WEBSEARCH_API_BASE=http://pre-qianfan.bilibili.co/v2/ai_search/web_search

# 封面生成（gpt-image-2 网关）
LLM_GATEWAY_API_KEY=your-key-here

# 实时热榜数据源：自部署的 imsyy/DailyHotApi 地址（选题第零步扫风向用）。
# Docker 或 Vercel 部署一个实例后填这里，如 http://localhost:6688。
# 不配则 fetch_hotlist.py 会报错——本工具绝不返回缓存/旧热榜。
DAILYHOT_API_BASE=http://localhost:6688
